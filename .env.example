# Copy to .env and adjust values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=your-db-password
# OR use a full connection string instead of the DB_* fields above:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/inventory_db

# Tests use a local dedicated inventory_db_test (create it first:
# createdb -U postgres inventory_db_test). The suite forces localhost and
# clears DATABASE_URL; TEST_DB_NAME is read from the shell, not this file.
# For intentional remote migrations only:
# ALLOW_REMOTE_MIGRATIONS=1

# Set to false to skip the star-schema ETL rebuild on every app start when the
# data warehouse is already built (recommended for remote databases).
# RUN_ETL_ON_STARTUP=true

SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=development

# Rate limiting (flask-limiter) uses its built-in in-process store and the
# caches are in-process too — nothing to configure. The app is pinned to a
# single worker; the per-account login lockout is persisted in PostgreSQL.

# Set to 1 only when behind a trusted reverse proxy (Render/nginx/ALB)
# so X-Forwarded-For is honored for client IPs / rate-limit keys.
# TRUST_PROXY=1

# Comma-separated extra hostnames allowed in the Host header (Flask 3.1).
# Render's RENDER_EXTERNAL_HOSTNAME is trusted automatically; add custom
# domains here when deploying elsewhere.
# TRUSTED_HOSTS=inventory.example.com


# Optional SMTP settings — used to deliver password-reset emails.
# When SMTP_HOST is left empty the reset link is shown in the UI instead
# (development fallback). For Gmail, SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587 and the password is an App Password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your-gmail-address@gmail.com
MAIL_USE_TLS=true
PASSWORD_RESET_TTL_MINUTES=5